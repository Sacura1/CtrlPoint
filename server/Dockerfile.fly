FROM node:20-slim

WORKDIR /app/server

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY contracts ./contracts
RUN npm run build

EXPOSE 3001

CMD ["node", "dist/index.js"]
