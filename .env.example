NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public backend URL used in machine-readable agent manifests.
API_PUBLIC_URL=http://localhost:3001
# Optional: comma-separated list of allowed frontend origins
# CLIENT_URLS=http://localhost:5173,https://www.ctrlpoint.dev,https://ctrlpoint.dev
MNS_PUBLIC_DOMAIN=massahub.network
# Client-side override (Vite): VITE_MNS_PUBLIC_DOMAIN=massahub.network

# Billing
# Use Polar for global one-time credit purchases.
BILLING_PROVIDER=polar
POLAR_ENVIRONMENT=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_BUILDER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_STUDIO_PRODUCT_ID=

# Encryption key for storing user API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# GitHub OAuth App (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# GitHub App (for selected repository deploy access)
GITHUB_APP_NAME=
GITHUB_APP_ID=
# Paste the PEM with literal \n between lines when setting as an env var.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SETUP_URL=http://localhost:3001/api/github/setup

# Feature flags
# Set to true to let users pick AI models. The frontend reads this from /api/config.
ENABLE_MODEL_SELECTION=false

# Deploy worker
ENABLE_DEPLOY_WORKER=true
DEPLOY_WORKER_STATIC_CONCURRENCY=3
DEPLOY_WORKER_FRAMEWORK_CONCURRENCY=1

# Agent deploy API
# Agent keys are created from an authenticated account with POST /api/agent/keys.
# Circle Gateway/x402 lets agents pay with USDC without a CtrlPoint account.
CIRCLE_X402_ENABLED=false
CIRCLE_X402_SELLER_ADDRESS=
# Use https://gateway-api-testnet.circle.com for Arc Testnet while testing.
CIRCLE_X402_FACILITATOR_URL=https://gateway-api.circle.com
# Optional CAIP-2 network allowlist. Arc Testnet is eip155:5042002.
# Leave empty to accept all Circle Gateway-supported networks.
CIRCLE_X402_NETWORKS=
CIRCLE_X402_STATIC_DEPLOY_PRICE=$0.01
CIRCLE_X402_FRAMEWORK_DEPLOY_PRICE=$0.01
CIRCLE_X402_STATIC_UPDATE_PRICE=$0.001
CIRCLE_X402_FRAMEWORK_UPDATE_PRICE=$0.001
